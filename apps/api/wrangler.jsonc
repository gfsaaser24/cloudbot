{
    "name": "cloudbot-api",
    "main": "src/index.ts",
    "compatibility_date": "2026-02-05",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "env": {
        "dev": {
            "r2_buckets": [
                {
                    "binding": "CLOUDBOT_BUCKET",
                    "bucket_name": "cloudbot-dev-bucket",
                    "remote": true
                }
            ],
            "d1_databases": [
                {
                    "binding": "CLOUDBOT_DB",
                    "database_name": "cloudbot-db",
                    "database_id": "CLOUDBOT_DB_ID",
                    "migrations_dir": "./../../packages/server/src/drizzle/migrations"
                }
            ],
            "ai": {
                "binding": "AI",
                "remote": true
            }
        },
        "production": {
            "r2_buckets": [
                {
                    "binding": "CLOUDBOT_BUCKET",
                    "bucket_name": "cloudbot-bucket",
                    "remote": true
                }
            ],
            "d1_databases": [
                {
                    "binding": "CLOUDBOT_DB",
                    "database_name": "cloudbot-db",
                    "database_id": "e925f00b-9d42-46b0-89fc-e69a969f43cb",
                    "migrations_dir": "./../../packages/server/src/drizzle/migrations"
                }
            ],
            "ai": {
                "binding": "AI",
                "remote": true
            }
        }
    },
    "route": {
        "custom_domain": true,
        "zone_name": "editmypodcast.agency",
        "pattern": "cloudchat-api.editmypodcast.agency"
    },
    "workers_dev": false,
    "observability": {
        "enabled": true,
        "logs": {
            "enabled": true,
            "head_sampling_rate": 1
        },
        "traces": {
            "enabled": true,
            "head_sampling_rate": 0.01
        }
    }
}
