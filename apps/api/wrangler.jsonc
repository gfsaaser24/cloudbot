{
    "name": "cloudbot-api",
    "main": "src/index.ts",
    "compatibility_date": "2026-02-05",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "env": {
        "dev": {
            "r2_buckets": [
                {
                    "binding": "CLOUDBOT_BUCKET",
                    "bucket_name": "cloudbot-dev-bucket",
                    "remote": true
                }
            ],
            "d1_databases": [
                {
                    "binding": "CLOUDBOT_DB",
                    "database_name": "cloudbot-db",
                    "database_id": "CLOUDBOT_DB_ID",
                    "migrations_dir": "./../../packages/server/src/drizzle/migrations"
                }
            ],
            "ai": {
                "binding": "AI",
                "remote": true
            },
            "workflows": [
                {
                    "name": "cloudbot-transcript-import-dev",
                    "binding": "TRANSCRIPT_IMPORT",
                    "class_name": "TranscriptImport"
                }
            ]
        },
        "production": {
            "r2_buckets": [
                {
                    "binding": "CLOUDBOT_BUCKET",
                    "bucket_name": "cloudbot-bucket",
                    "remote": true
                }
            ],
            "d1_databases": [
                {
                    "binding": "CLOUDBOT_DB",
                    "database_name": "cloudbot-db",
                    "database_id": "e925f00b-9d42-46b0-89fc-e69a969f43cb",
                    "migrations_dir": "./../../packages/server/src/drizzle/migrations"
                }
            ],
            "ai": {
                "binding": "AI",
                "remote": true
            },
            // YouTube channel/playlist transcript imports (apps/api/src/workflows/transcript-import.ts)
            "workflows": [
                {
                    "name": "cloudbot-transcript-import",
                    "binding": "TRANSCRIPT_IMPORT",
                    "class_name": "TranscriptImport"
                }
            ]
        }
    },
    // Static exports of apps/web (at /) and apps/dashboard (at /dashboard), assembled by `pnpm build-assets`.
    // The Worker runs first for everything except hashed JS/CSS chunks, so it can add the CSP nonce and locale redirects.
    "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "not_found_handling": "404-page",
        "run_worker_first": ["/*", "!/_next/*", "!/dashboard/_next/*"]
    },
    "route": {
        "custom_domain": true,
        "zone_name": "editmypodcast.agency",
        "pattern": "cloudchat.editmypodcast.agency"
    },
    "workers_dev": false,
    "observability": {
        "enabled": true,
        "logs": {
            "enabled": true,
            "head_sampling_rate": 1
        },
        "traces": {
            "enabled": true,
            "head_sampling_rate": 0.01
        }
    }
}
