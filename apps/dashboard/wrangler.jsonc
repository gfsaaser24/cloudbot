{
  "main": ".open-next/worker.js",
  "name": "cloudbot-dashboard",
  "compatibility_date": "2026-02-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "route": {
    "custom_domain": true,
    "zone_name": "editmypodcast.agency",
    "pattern": "cloudchat-admin.editmypodcast.agency"
  },
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}